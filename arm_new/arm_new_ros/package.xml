<?xml version="1.0"?>
<package format="3">
  <name>arm_new_ros</name>
  <version>0.1.0</version>
  <description>ROS2 adapter node for the arm_new Python arm API.</description>
  <maintainer email="todo@example.com">arm_new</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>arm_new_interfaces</depend>
  <exec_depend>quadruped_robot_competition</exec_depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>ament_index_python</depend>
  <depend>tf2_ros</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
