ARG BASE_IMAGE=isaac_ros_cuvslam_runtime:humble-rs-cone
FROM ${BASE_IMAGE}

ARG TORCH_WHEEL_URL
ARG TORCH_WHEEL_SHA256
ARG TORCHVISION_WHEEL_URL
ARG TORCHVISION_WHEEL_SHA256

LABEL org.opencontainers.image.title="D455 cuVSLAM cone pick-place runtime" \
      org.opencontainers.image.base.name="isaac_ros_cuvslam_runtime:humble-rs-cone" \
      org.quadruped.pick_place.torch="2.0.0+nv23.5" \
      org.quadruped.pick_place.torchvision="0.15.1" \
      org.quadruped.pick_place.ultralytics="8.2.103" \
      org.quadruped.pick_place.model_sha256="3ed76de727a87be8d64cc3b259bf2b0ec39daaaa3fac1f3f97af249824abc648"

RUN test -n "${TORCH_WHEEL_URL}" \
 && test -n "${TORCH_WHEEL_SHA256}" \
 && test -n "${TORCHVISION_WHEEL_URL}" \
 && test -n "${TORCHVISION_WHEEL_SHA256}" \
 && grep -E '^deb http://ports\.ubuntu\.com/ubuntu-ports/' /etc/apt/sources.list \
      > /tmp/pick_place_ubuntu_sources.list \
 && test -s /tmp/pick_place_ubuntu_sources.list \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get \
      -o Dir::Etc::sourcelist="/tmp/pick_place_ubuntu_sources.list" \
      -o Dir::Etc::sourceparts="-" \
      update \
 && apt-get install -y --no-install-recommends ca-certificates curl python3-pip \
 && rm -f /tmp/pick_place_ubuntu_sources.list \
 && rm -rf /var/lib/apt/lists/* \
 && torch_wheel_name="${TORCH_WHEEL_URL%%\?*}" \
 && torch_wheel_name="${torch_wheel_name##*/}" \
 && torchvision_wheel_name="${TORCHVISION_WHEEL_URL%%\?*}" \
 && torchvision_wheel_name="${torchvision_wheel_name##*/}" \
 && case "$torch_wheel_name" in *.whl) ;; *) echo "invalid torch wheel URL basename: $torch_wheel_name" >&2; exit 1 ;; esac \
 && case "$torchvision_wheel_name" in *.whl) ;; *) echo "invalid torchvision wheel URL basename: $torchvision_wheel_name" >&2; exit 1 ;; esac \
 && test "$torch_wheel_name" != "$torchvision_wheel_name" \
 && python3 -c 'from pip._internal.models.wheel import Wheel; import sys; [Wheel(name) for name in sys.argv[1:]]' \
      "$torch_wheel_name" "$torchvision_wheel_name" \
 && torch_wheel="/tmp/$torch_wheel_name" \
 && torchvision_wheel="/tmp/$torchvision_wheel_name" \
 && curl --fail --location --retry 3 "${TORCH_WHEEL_URL}" -o "$torch_wheel" \
 && curl --fail --location --retry 3 "${TORCHVISION_WHEEL_URL}" -o "$torchvision_wheel" \
 && echo "${TORCH_WHEEL_SHA256}  $torch_wheel" | sha256sum --check --strict \
 && echo "${TORCHVISION_WHEEL_SHA256}  $torchvision_wheel" | sha256sum --check --strict \
 && python3 -m pip uninstall -y torch torchvision ultralytics \
 && python3 -m pip install --no-cache-dir "$torch_wheel" "$torchvision_wheel" \
 && rm -f "$torch_wheel" "$torchvision_wheel"

RUN cuda_deb_dir=/tmp/pick_place_cuda_debs \
 && mkdir -p "$cuda_deb_dir" \
 && curl --fail --location --retry 3 \
      https://repo.download.nvidia.com/jetson/common/pool/main/libc/libcurand/libcurand-11-4_10.2.5.297-1_arm64.deb \
      -o "$cuda_deb_dir/libcurand-11-4_10.2.5.297-1_arm64.deb" \
 && curl --fail --location --retry 3 \
      https://repo.download.nvidia.com/jetson/common/pool/main/libc/libcufft/libcufft-11-4_10.6.0.202-1_arm64.deb \
      -o "$cuda_deb_dir/libcufft-11-4_10.6.0.202-1_arm64.deb" \
 && curl --fail --location --retry 3 \
      https://repo.download.nvidia.com/jetson/common/pool/main/libc/libcusparse/libcusparse-11-4_11.6.0.299-1_arm64.deb \
      -o "$cuda_deb_dir/libcusparse-11-4_11.6.0.299-1_arm64.deb" \
 && curl --fail --location --retry 3 \
      https://repo.download.nvidia.com/jetson/common/pool/main/libc/libcusolver/libcusolver-11-4_11.2.0.297-1_arm64.deb \
      -o "$cuda_deb_dir/libcusolver-11-4_11.2.0.297-1_arm64.deb" \
 && curl --fail --location --retry 3 \
      https://repo.download.nvidia.com/jetson/common/pool/main/c/cuda-nvtx/cuda-nvtx-11-4_11.4.300-1_arm64.deb \
      -o "$cuda_deb_dir/cuda-nvtx-11-4_11.4.300-1_arm64.deb" \
 && cd "$cuda_deb_dir" \
 && printf '%s\n' \
      'd4e0025162c0c68d792b373f50843328234918e450258873f6325630580af692  libcurand-11-4_10.2.5.297-1_arm64.deb' \
      '87f2161d58e3766f4d1ac695dae673ad6bad0e0e8a5f9866506dccae6c72219f  libcufft-11-4_10.6.0.202-1_arm64.deb' \
      'b1fedfac989075df9dfa3c36977df61fd3f3f1969bef10c451d03b3801dda04a  libcusparse-11-4_11.6.0.299-1_arm64.deb' \
      'f2e39c718793bfbe6dd99bac3ccf8029b7f869bb92160fce5b281e32b4535c6e  libcusolver-11-4_11.2.0.297-1_arm64.deb' \
      '921de34da9edfbea002e48c817fc6f178da922384ef7db16c13233263d905812  cuda-nvtx-11-4_11.4.300-1_arm64.deb' \
      | sha256sum --check --strict \
 && test "$(dpkg-deb -f libcurand-11-4_10.2.5.297-1_arm64.deb Package)" = libcurand-11-4 \
 && test "$(dpkg-deb -f libcufft-11-4_10.6.0.202-1_arm64.deb Package)" = libcufft-11-4 \
 && test "$(dpkg-deb -f libcusparse-11-4_11.6.0.299-1_arm64.deb Package)" = libcusparse-11-4 \
 && test "$(dpkg-deb -f libcusolver-11-4_11.2.0.297-1_arm64.deb Package)" = libcusolver-11-4 \
 && test "$(dpkg-deb -f cuda-nvtx-11-4_11.4.300-1_arm64.deb Package)" = cuda-nvtx-11-4 \
 && test "$(dpkg-deb -f libcurand-11-4_10.2.5.297-1_arm64.deb Architecture)" = arm64 \
 && test "$(dpkg-deb -f libcufft-11-4_10.6.0.202-1_arm64.deb Architecture)" = arm64 \
 && test "$(dpkg-deb -f libcusparse-11-4_11.6.0.299-1_arm64.deb Architecture)" = arm64 \
 && test "$(dpkg-deb -f libcusolver-11-4_11.2.0.297-1_arm64.deb Architecture)" = arm64 \
 && test "$(dpkg-deb -f cuda-nvtx-11-4_11.4.300-1_arm64.deb Architecture)" = arm64 \
 && dpkg -i ./*.deb \
 && test "$(dpkg-query -W -f='${Version}' libcurand-11-4)" = 10.2.5.297-1 \
 && test "$(dpkg-query -W -f='${Version}' libcufft-11-4)" = 10.6.0.202-1 \
 && test "$(dpkg-query -W -f='${Version}' libcusparse-11-4)" = 11.6.0.299-1 \
 && test "$(dpkg-query -W -f='${Version}' libcusolver-11-4)" = 11.2.0.297-1 \
 && test "$(dpkg-query -W -f='${Version}' cuda-nvtx-11-4)" = 11.4.300-1 \
 && test -e /usr/local/cuda-11.4/targets/aarch64-linux/lib/libcurand.so.10 \
 && test -e /usr/local/cuda-11.4/targets/aarch64-linux/lib/libcufft.so.10 \
 && test -e /usr/local/cuda-11.4/targets/aarch64-linux/lib/libcusparse.so.11 \
 && test -e /usr/local/cuda-11.4/targets/aarch64-linux/lib/libcusolver.so.11 \
 && test -e /usr/local/cuda-11.4/targets/aarch64-linux/lib/libnvToolsExt.so.1 \
 && rm -rf "$cuda_deb_dir"

COPY docker/d455_perception/requirements.lock /tmp/pick_place_requirements.lock
RUN python3 -m pip install --no-cache-dir --no-deps -r /tmp/pick_place_requirements.lock \
 && if ! python3 -m pip check > /tmp/pick_place_pip_check.txt 2>&1; then \
      if grep -Ev '^ultralytics [^ ]+ requires opencv-python.*which is not installed\.$' /tmp/pick_place_pip_check.txt | grep -q .; then \
        cat /tmp/pick_place_pip_check.txt; exit 1; \
      fi; \
    fi \
 && rm -f /tmp/pick_place_pip_check.txt \
 && rm -f /tmp/pick_place_requirements.lock

COPY docker/d455_perception/ /opt/quadruped/perception/bin/
COPY src/nodes/perception/yolo_udp_bridge_core.py \
     /opt/quadruped/perception/bin/yolo_udp_bridge_core.py
COPY InstanceSegmentation/projects/gauge/model/best.pt \
     /opt/quadruped/perception/models/gauge_ad_best.pt

RUN chmod +x \
      /opt/quadruped/perception/bin/run_apriltag_pose_node.sh \
      /opt/quadruped/perception/bin/run_yolo_3d_node.sh \
 && PYTHONPATH=/opt/quadruped/perception/bin \
      python3 /opt/quadruped/perception/bin/verify_runtime.py --build-stage
