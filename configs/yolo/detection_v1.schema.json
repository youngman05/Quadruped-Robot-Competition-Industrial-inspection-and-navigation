{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quadruped.local/schemas/d455-detection-v1.json",
  "title": "D455 YOLO 3D detection packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "stamp",
    "frame_id",
    "inference_ms",
    "detections"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sec", "nanosec"],
      "properties": {
        "sec": {"type": "integer", "minimum": 0},
        "nanosec": {"type": "integer", "minimum": 0, "maximum": 999999999}
      }
    },
    "frame_id": {"const": "camera_link"},
    "inference_ms": {"type": "number", "minimum": 0},
    "detections": {
      "type": "array",
      "items": {"$ref": "#/$defs/detection"}
    }
  },
  "$defs": {
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_id",
        "class_name",
        "confidence",
        "bbox",
        "center_px",
        "mask_area_px",
        "depth_m",
        "depth_valid_ratio",
        "position_valid",
        "position_m"
      ],
      "properties": {
        "class_id": {"type": "integer", "minimum": 0, "maximum": 2},
        "class_name": {"enum": ["red", "green", "obstacle"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bbox": {
          "type": "array",
          "prefixItems": [
            {"type": "integer"},
            {"type": "integer"},
            {"type": "integer"},
            {"type": "integer"}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "center_px": {
          "type": "array",
          "prefixItems": [{"type": "integer"}, {"type": "integer"}],
          "minItems": 2,
          "maxItems": 2
        },
        "mask_area_px": {"type": "integer", "minimum": 0},
        "depth_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "depth_valid_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "position_valid": {"type": "boolean"},
        "position_m": {
          "type": ["array", "null"],
          "prefixItems": [
            {"type": "number"},
            {"type": "number"},
            {"type": "number"}
          ],
          "minItems": 3,
          "maxItems": 3
        }
      }
    }
  }
}

